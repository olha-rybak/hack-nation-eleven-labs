# The interviewer LLM (Claude) runs inside ElevenLabs; no Anthropic key needed.
# ElevenLabs agent ID for the interviewer (pasted into the test page, or ?agent=<id>).
ELEVENLABS_INTERVIEWER_AGENT_ID=

# Local vision model (llama-server). Slot 0 turns frame pairs into events.
LLAMA_SERVER_URL=http://127.0.0.1:8080
LLM_SLOTS=1
LLM_TIMEOUT_SEC=60
LLM_HEALTH_TIMEOUT_SEC=5
# max tokens for one vision reply
VISION_MAX_TOKENS=512
# let the model reason before emitting events (slower, maybe more accurate)
VISION_THINKING=false
# vision events below this confidence are dropped, not guessed
EVENT_MIN_CONFIDENCE=0.6

# Capture loop
FRAME_FPS=1
# browser change detection: a frame is sent when at least this many cells of a
# 160px-wide greyscale thumbnail differ from the last sent frame. Tab capture
# shows 4-6 cells of noise on a still screen; a real edit changes 50+.
FRAME_CHANGE_MIN_CELLS=12
# where per-session data is stored
SESSIONS_DIR=data/sessions

# Pause detector: when the agent may ask
PAUSE_SCREEN_STILL_SEC=4
PAUSE_SILENCE_SEC=2
ASK_COOLDOWN_SEC=60
MAX_LIVE_QUESTIONS=5
PAUSE_TICK_SEC=0.25
