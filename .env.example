# The interviewer LLM (Claude) runs inside ElevenLabs; the Work Map builder below needs its own key.
# ElevenLabs agent ID for the interviewer (pasted into the test page, or ?agent=<id>).
ELEVENLABS_INTERVIEWER_AGENT_ID=

# Vision: turns frame pairs into events. "anthropic" = Claude (needs ANTHROPIC_API_KEY; gets the
# PII-masked frames), "local" = the llama-server below.
VISION_PROVIDER=anthropic
# claude-haiku-4-5 = fastest and cheapest; claude-sonnet-5-5 reads dense screens better
VISION_MODEL=claude-haiku-4-5
# Sonnet/Opus only: thinking depth per frame pair (Haiku ignores it)
VISION_EFFORT=low

# Local vision model (llama-server). Slot 0 turns frame pairs into events.
LLAMA_SERVER_URL=http://127.0.0.1:8080
LLM_SLOTS=1
LLM_TIMEOUT_SEC=60
LLM_HEALTH_TIMEOUT_SEC=5
# max tokens for one vision reply
VISION_MAX_TOKENS=512
# let the model reason before emitting events (slower, maybe more accurate)
VISION_THINKING=false
# vision events below this confidence are dropped, not guessed
EVENT_MIN_CONFIDENCE=0.6

# Capture loop
FRAME_FPS=1
# browser change detection: a frame is sent when at least this many cells of a
# 160px-wide greyscale thumbnail differ from the last sent frame. Tab capture
# shows 4-6 cells of noise on a still screen; a real edit changes 50+.
FRAME_CHANGE_MIN_CELLS=12
# where per-session data is stored
SESSIONS_DIR=data/sessions
# what experts told us, across sessions (T-110); outside the session folders
KNOWLEDGE_PATH=data/knowledge/graph.json
# the Known slice sent with each ask_now: at most this many facts / characters (~500 tokens)
KNOWN_MAX_FACTS=10
KNOWN_MAX_CHARS=2000
# how far back off the record deletes, on the session's own clock
OFF_THE_RECORD_WINDOW_SEC=30

# Pause detector: when the agent may ask
PAUSE_SCREEN_STILL_SEC=4
PAUSE_SILENCE_SEC=2
ASK_COOLDOWN_SEC=60
MAX_LIVE_QUESTIONS=5
# A guardrail question is forced by this question if none was asked yet (T-108)
GUARDRAIL_BY_QUESTION=4
PAUSE_TICK_SEC=0.25
# expert speaking, from ElevenLabs' voice activity score (0-1): speaking above the threshold,
# not speaking once no score was above it for VAD_RELEASE_MS (bridges the gaps between words)
VAD_SPEECH_THRESHOLD=0.5
VAD_RELEASE_MS=400

# Work Map builder and debrief LLM. "anthropic" = Claude (needs ANTHROPIC_API_KEY);
# "local" = the llama-server above, free but much weaker, for wiring tests.
ANTHROPIC_API_KEY=
MAP_LLM_PROVIDER=anthropic
MAP_LLM_MODEL=claude-opus-5-5
MAP_LLM_EFFORT=high
MAP_LLM_TIMEOUT_SEC=300

# PII redaction (Presidio). Transcripts and event text become <PERSON_1>-style placeholders,
# stable within a session; stored frames get OCR-detected regions blacked out. Frame masking
# needs the Tesseract binary; without it only text is redacted (/health reports "text-only").
# Needs: pip install -e ".[privacy]" and python -m spacy download en_core_web_lg
PRESIDIO_ENABLED=true
PRESIDIO_SPACY_MODEL=en_core_web_lg
PRESIDIO_ENTITIES=PERSON,EMAIL_ADDRESS,IBAN_CODE,PHONE_NUMBER,LOCATION
PRESIDIO_SCORE_THRESHOLD=0.4
# countries whose phone number formats are recognized (Presidio's default misses AT and CZ)
PRESIDIO_PHONE_REGIONS=AT,DE,CZ,GB,US

# Tesseract binary for frame masking; empty = look it up on PATH
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
