# llama-server base URL
LLAMA_SERVER_URL=http://127.0.0.1:8080
# number of llama-server parallel slots (0 = vision, 1 = agent turns)
LLM_SLOTS=2
# timeout for a normal model call, seconds
LLM_TIMEOUT_SEC=60
# timeout for the /health model ping, seconds
LLM_HEALTH_TIMEOUT_SEC=5
# frame sampling rate
FRAME_FPS=1
# screen must be still this long before a pause counts
PAUSE_SCREEN_STILL_SEC=4
# mic must be silent this long before a pause counts
PAUSE_SILENCE_SEC=2
# minimum gap between live questions
ASK_COOLDOWN_SEC=60
# live question budget per session
MAX_LIVE_QUESTIONS=5
# how much recent session log "off the record" deletes
OFF_THE_RECORD_WINDOW_SEC=30
# shared secret for the ElevenLabs custom-LLM proxy
AGENT_PROXY_TOKEN=change-me
# redact PII with Presidio before persisting
PRESIDIO_ENABLED=true
# ElevenLabs API key
ELEVENLABS_API_KEY=
# ElevenLabs agent id
ELEVENLABS_AGENT_ID=
# where per-session data is stored
SESSIONS_DIR=data/sessions
# vision events below this confidence are dropped, not guessed
EVENT_MIN_CONFIDENCE=0.6
# max tokens for one vision (slot 0) reply
VISION_MAX_TOKENS=512
# let the model reason before emitting events (slower, maybe more accurate)
VISION_THINKING=false
# how often the pause detector re-checks, seconds
PAUSE_TICK_SEC=0.25
